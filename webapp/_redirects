# ═══════════════════════════════════════════════════════════════════════════════
# Rolenaut Netlify URL Routing & Rewrites
# ═══════════════════════════════════════════════════════════════════════════════

# Security: Block sensitive and internal development files from public HTTP access
/package.json           /404.html           404!
/package-lock.json      /404.html           404!
/server.js              /404.html           404!
/netlify/*              /404.html           404!
/.env*                  /404.html           404!
/data/*                 /404.html           404!

# Clean static application routes
/jobs                   /jobs.html          200
/about                  /about.html         200
/onboarding             /onboarding.html    200
/profile                /profile.html       200
/privacy                /privacy.html       200
/terms                  /terms.html         200
/interview-prep         /interview-prep.html 200
/resume-guide           /resume-guide.html  200
/scraper-guide          /scraper-guide.html 200

# API Rewrite proxies to Netlify Serverless Functions
/api/jobs               /.netlify/functions/getJobs          200
/api/site-stats         /.netlify/functions/getSiteStats     200
/api/user-profile       /.netlify/functions/userProfile       200
/api/schema-discover    /.netlify/functions/schemaDiscover    200

# Canonical redirects for .html extensions
/*.html                 /:splat             301!

# Dynamic programmatic routes & filter paths for Job Feed
/jobs/*                 /jobs.html          200
